<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Darwan</vendor>
  <vendor_url>https://github.com/mah3uz/darwan</vendor_url>
  <action id="org.darwan.helper">
    <description>Change the SDDM login screen theme</description>
    <message>Authentication is required to change the login screen theme</message>
    <icon_name>preferences-desktop-theme</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/darwan/darwan-helper</annotate>
  </action>
</policyconfig>
